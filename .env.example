# Keep real values in your local environment or hosting secret manager.
# A PostgreSQL URL selects PostgreSQL; leave unset to use local SQLite.
MEDGUARD_DATABASE_URL=
MEDGUARD_DB_PATH=backend/medguard.sqlite3
MEDGUARD_ADMIN_KEY=
MEDGUARD_PUBLIC_URL=http://127.0.0.1:8000

# Local SMTP option (Gmail App Password only; never use your normal password).
MEDGUARD_GMAIL_ADDRESS=
MEDGUARD_GMAIL_APP_PASSWORD=

# Hosted Gmail API OAuth option (works over HTTPS where SMTP is blocked).
MEDGUARD_GMAIL_CLIENT_ID=
MEDGUARD_GMAIL_CLIENT_SECRET=
MEDGUARD_GMAIL_REFRESH_TOKEN=
